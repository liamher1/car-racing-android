<?xml version="1.0" encoding="utf-8"?>
<!--
    Racing-red adaptive icon background.
    Diagonal gradient (bright red → deep crimson) + a subtle centre highlight
    so the white car icon reads clearly on any launcher shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base diagonal red gradient -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FFEF5350" />
                <item android:offset="1.0" android:color="#FFB71C1C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft centre highlight so the icon feels 3-D -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="48">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
